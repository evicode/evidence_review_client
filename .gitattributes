# Normalise line endings so the repo is identical regardless of platform.
* text=auto eol=lf

# Windows-native scripts are happier with CRLF.
*.ps1  text eol=crlf
*.iss  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binaries.
*.ico  binary
*.png  binary
*.jpg  binary
*.dll  binary
*.xlsx binary
